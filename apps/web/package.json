{
  "name": "@agentforge/web",
  "version": "0.1.0",
  "description": "AgentForge Web UI - sessions, settings, providers, MCP, subagents",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@agentforge/core": "*",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.12",
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "vite": "^5.4.2",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "concurrently": "^8.2.2"
  }
}
