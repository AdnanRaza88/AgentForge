{
  "name": "@agentforge/cli",
  "version": "0.1.0",
  "description": "AgentForge CLI - the `agentforge` terminal agent",
  "type": "module",
  "bin": {
    "agentforge": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --loader ts-node/esm src/cli.ts",
    "dev": "tsc -w -p tsconfig.json"
  },
  "dependencies": {
    "@agentforge/core": "*",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
