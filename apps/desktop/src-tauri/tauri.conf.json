{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentForge",
  "version": "0.1.0",
  "identifier": "com.agentforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:server -w apps/web & npm run dev:client -w apps/web",
    "beforeBuildCommand": "npm run build -w apps/web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentForge",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
