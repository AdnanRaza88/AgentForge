# Copy this file to .env and fill in the key(s) for whichever provider(s) you want to use.
# You only need ONE of these to get started. See docs/06-PROVIDERS.md for details.

# --- Paid providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Free-tier / free providers ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- 100% free, local, no key needed ---
# Requires Ollama running locally: https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional: for /agents "git create_pr" action ---
# GITHUB_TOKEN=
