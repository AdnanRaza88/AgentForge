# Copy to .env and fill in the key(s) for the provider(s) you want.
# You only need ONE to get started. See docs/06-PROVIDERS.md.

# --- Paid / strong coding ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Free-tier friendly ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- 100% free local (no key) ---
# Install: https://ollama.com  then e.g. `ollama pull llama3.2`
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional ---
# GITHUB_TOKEN=   # for MCP GitHub / PR flows later
